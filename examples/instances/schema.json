{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "horizon": {
            "description": "horizon length in days",
            "type": "integer"
        },
        "start_date": {
            "description": "date of the first day of the horizon (YYYY-MM-DD), used to compute weekdays and weekends; defaults to 1970-01-05 (a Monday)",
            "type": "string",
            "format": "date"
        },
        "shifts": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "shift_id": {
                        "type": "string"
                    },
                    "length": {
                        "description": "shift length in mins",
                        "type": "integer"
                    },
                    "cannot_follow": {
                        "description": "shifts which cannot follow this shift",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "workload_weight": {
                        "description": "shift workload weight",
                        "type": "number"
                    }
                },
                "required": [
                    "shift_id",
                    "length",
                    "cannot_follow",
                    "workload_weight"
                ]
            }
        },
        "staff": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "employee_id": {
                        "type": "string"
                    },
                    "role_id": {
                        "description": "professional role of the employee (e.g. lead, registered, assistant), used by the cover role requirements",
                        "type": "string"
                    },
                    "max_shifts": {
                        "description": "maximum number of shifts that can be assigned to the employee",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "shift_id": {
                                    "type": "string"
                                },
                                "max_shifts": {
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "shift_id",
                                "max_shifts"
                            ]
                        }
                    },
                    "max_total_minutes": {
                        "description": "maximum amount of total time in minutes that can be assigned to the employee",
                        "type": "integer"
                    },
                    "min_total_minutes": {
                        "description": "minimum amount of total time in minutes that should be assigned to the employee; soft: the shortage is minimised and reported in the solution underallocations",
                        "type": "integer"
                    },
                    "max_weekly_minutes": {
                        "description": "maximum amount of weekly time in minutes that can be assigned to the employee",
                        "type": "integer"
                    },
                    "min_weekly_minutes": {
                        "description": "minimum amount of weekly time in minutes that should be assigned to the employee, where weeks are 7-day blocks from start_date and the minimum of a final partial block is prorated by its number of days; soft: the shortage is minimised and reported in the solution underallocations",
                        "type": "integer"
                    },
                    "max_consecutive_shifts": {
                        "description": "maximum number of consecutive shifts that can be worked before having a day oﬀ",
                        "type": "integer"
                    },
                    "min_consecutive_shifts": {
                        "description": "minimum number of consecutive shifts that can be worked before having a day oﬀ",
                        "type": "integer"
                    },
                    "min_consecutive_days_off": {
                        "description": "minimum number of consecutive days oﬀ that must be assigned before assigning a shift",
                        "type": "integer"
                    },
                    "max_weekends": {
                        "description": "maximum number of weekends (a weekend is worked if there is a shift on the Saturday or on the Sunday; a Saturday or Sunday whose other weekend day falls outside the horizon counts as a weekend on its own)",
                        "type": "integer"
                    },
                    "workload_level": {
                        "description": "nurse current workload level",
                        "type": "integer"
                    }
                },
                "required": [
                    "employee_id",
                    "role_id",
                    "max_shifts",
                    "max_total_minutes",
                    "min_total_minutes",
                    "max_weekly_minutes",
                    "min_weekly_minutes",
                    "max_consecutive_shifts",
                    "min_consecutive_shifts",
                    "min_consecutive_days_off",
                    "max_weekends",
                    "workload_level"
                ]
            }
        },
        "days_off": {
            "description": "shifts must not be assigned to the specified employee on the specified days",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "employee_id": {
                        "type": "string"
                    },
                    "day_indexes": {
                        "type": "array",
                        "items": [
                            {
                                "type": "integer"
                            }
                        ]
                    }
                },
                "required": [
                    "employee_id",
                    "day_indexes"
                ]
            }
        },
        "shift_on_requests": {
            "description": "if the specified shift is not assigned to the specified employee on the specified day then the solution's penalty is the specified weight value",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "employee_id": {
                        "type": "string"
                    },
                    "day": {
                        "type": "integer"
                    },
                    "shift_id": {
                        "type": "string"
                    },
                    "weight": {
                        "type": "integer"
                    }
                },
                "required": [
                    "employee_id",
                    "day",
                    "shift_id",
                    "weight"
                ]
            }
        },
        "shift_off_requests": {
            "description": "if the specified shift is assigned to the specified employee on the specified day then the solution's penalty is the weight value",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "employee_id": {
                        "type": "string"
                    },
                    "day": {
                        "type": "integer"
                    },
                    "shift_id": {
                        "type": "string"
                    },
                    "weight": {
                        "type": "integer"
                    }
                },
                "required": [
                    "employee_id",
                    "day",
                    "shift_id",
                    "weight"
                ]
            }
        },
        "cover": {
            "description": "for each day and shift, exactly role_requirements[role] employees with that role must be assigned (hard constraint); a requirement of 0 means that no employee with that role can be assigned; roles not listed in role_requirements, and days/shifts without a cover entry, are treated as a requirement of 0",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "day": {
                        "type": "integer"
                    },
                    "shift_id": {
                        "type": "string"
                    },
                    "role_requirements": {
                        "description": "required number of employees for each role",
                        "type": "object",
                        "additionalProperties": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "minProperties": 1
                    },
                    "weight_for_under": {
                        "type": "integer",
                        "description": "Deprecated: ignored by the solver since cover is exact",
                        "deprecated": true
                    },
                    "weight_for_over": {
                        "type": "integer",
                        "description": "Deprecated: ignored by the solver since cover is exact",
                        "deprecated": true
                    }
                },
                "required": [
                    "day",
                    "shift_id",
                    "role_requirements"
                ]
            }
        },
        "blocked_weekdays": {
            "description": "the specified shifts must not be assigned to any employee on the specified weekday",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "weekday": {
                        "description": "Monday = 0, Tuesday = 1, ..., Sunday = 6",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 6
                    },
                    "shift_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "minItems": 1
                    }
                },
                "required": [
                    "weekday",
                    "shift_ids"
                ]
            }
        },
        "workload_threshold": {
            "description": "workload threshold that each nurse is required to stay below",
            "type": "integer"
        },
        "underallocation_weights": {
            "description": "objective weights for the shortage against the soft minimum working minutes, as cost per missing minute; compare them with the shift request weights, e.g. one missing 480-minute shift costs 480 * weight; non-integer values are truncated to integers, as for the other integer fields",
            "type": "object",
            "properties": {
                "total": {
                    "description": "cost per minute missing from min_total_minutes",
                    "type": "integer",
                    "minimum": 0,
                    "default": 1
                },
                "weekly": {
                    "description": "cost per minute missing from min_weekly_minutes, in each planning week",
                    "type": "integer",
                    "minimum": 0,
                    "default": 1
                }
            }
        }
    },
    "required": [
        "horizon",
        "shifts",
        "staff",
        "days_off",
        "shift_on_requests",
        "shift_off_requests",
        "cover",
        "workload_threshold"
    ]
}