        {
            "shift_id": "morning",
            "length": 480, // shift length in mins
            "cannot_follow": [], // shifts which cannot follow this shift
            "stress_weight": 1.0 // shift stress weight
        },
        {
            "shift_id": "evening",
            "length": 480,
            "cannot_follow": [
                "morning"
            ],
            "stress_weight": 1.1
        },
        {
            "shift_id": "night",
            "length": 480,
            "cannot_follow": [
                "morning",
                "evening"
            ],
            "stress_weight": 1.2
        }
    ],

